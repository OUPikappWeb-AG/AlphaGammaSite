---
/**
 * THE CHAPTER RECORD — the signature element of this site.
 *
 * The design thesis in one component: the chapter's numbers *are* the
 * argument, so they are typeset as a record rather than as marketing. Every
 * figure comes from chapter.json, carries the period it describes, and names
 * its source at the foot of the band.
 *
 * This is the one place the design spends any risk. Everything else stays
 * quiet on purpose.
 *
 * To change a number, edit src/data/chapter.json. Never edit it here.
 */
import { chapter, isPending } from '../lib/chapter';
import StatLine from './StatLine.astro';

const { academics, service, abilityExperience, membership } = chapter;

const allColumns = [
  {
    heading: 'Academics',
    stats: [
      { label: 'Chapter GPA', stat: academics.chapterGPA, format: 'gpa' as const, emphasis: true },
      {
        label: "All-men's average",
        stat: academics.allMensAverage,
        format: 'gpa' as const,
        note: 'Every undergraduate man at OU',
      },
      {
        label: 'All-fraternity average',
        stat: academics.allFraternityAvg,
        format: 'gpa' as const,
        note: 'Every fraternity chapter at OU',
      },
      { label: 'Graduation rate', stat: academics.gradRate, format: 'percent' as const },
      { label: 'Member retention', stat: academics.retentionRate, format: 'percent' as const },
    ],
  },
  {
    heading: 'Service and chapter',
    stats: [
      {
        label: 'Service hours',
        stat: service.hoursPerYear,
        format: 'integer' as const,
        emphasis: true,
        note: 'Completed by the chapter this year',
      },
      { label: 'Hours per member', stat: service.hoursPerMember, format: 'integer' as const },
      {
        label: 'Raised for The Ability Experience',
        stat: abilityExperience.raisedThisYear,
        format: 'currency' as const,
        emphasis: true,
      },
      { label: 'Active members', stat: membership.activeMembers, format: 'integer' as const },
      { label: 'New member class', stat: membership.pledgeClassSize, format: 'integer' as const },
    ],
  },
];

/**
 * Only figures that have actually been reported are shown.
 *
 * WHY THIS FILTERS RATHER THAN LABELLING
 * --------------------------------------
 * A line reading "Not yet reported" is honest, and for a *few* gaps it reads
 * as rigour — the page declining to estimate. Past a certain density it stops
 * reading that way and starts reading as an empty chapter: four real figures
 * next to six blanks looks like the chapter has nothing to say, which is the
 * opposite of what the record exists to do.
 *
 * The rows are still declared above and the fields still live in
 * `chapter.json`, so filling one in is all it takes to bring its line back.
 * The dev-only PendingFields banner lists everything still missing, so an
 * officer can see the gaps even though a visitor cannot.
 *
 * This reverses the earlier "null renders 'Not yet reported'" decision for
 * the Chapter Record specifically. Owner's call, 2026-08-24.
 */
const columns = allColumns
  .map((column) => ({ ...column, stats: column.stats.filter((entry) => !isPending(entry.stat)) }))
  .filter((column) => column.stats.length > 0);

/**
 * Sources are collected once and listed at the foot of the band, rather than
 * repeated on every line. Duplicates are collapsed.
 *
 * Only the sources behind figures that actually render are cited — otherwise
 * the page credits a record it is not showing anything from.
 */
const sources = [
  ...new Set(
    columns
      .flatMap((column) => column.stats)
      .map((entry) => entry.stat.source)
      .filter((s): s is string => Boolean(s)),
  ),
];

/** With nothing reported at all, the record has no argument to make. */
const hasRecord = columns.length > 0;
---

{hasRecord && (
<section aria-labelledby="chapter-record" class="border-y-2 border-gold bg-paper">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <header class="reveal max-w-2xl">
      <p class="font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-gold-text">
        The chapter record
      </p>
      <h2 id="chapter-record" class="mt-3 text-3xl leading-tight sm:text-4xl">
        Example headline stating what these numbers show.
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate">
        Example paragraph. Every figure below is dated and sourced. When a number has not been
        reported for the current period, this page says so rather than estimating.
      </p>
    </header>

    <div class="mt-12 grid gap-x-16 gap-y-4 lg:grid-cols-2">
      {
        columns.map((column, columnIndex) => (
          <div class="reveal" style={`transition-delay: ${80 + columnIndex * 90}ms`}>
            <h3 class="border-b border-gold pb-2 font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-ink">
              {column.heading}
            </h3>

            <div class="divide-y divide-ink/10">
              {column.stats.map((entry) => (
                <StatLine
                  label={entry.label}
                  stat={entry.stat}
                  format={entry.format}
                  emphasis={entry.emphasis}
                  note={entry.note}
                />
              ))}
            </div>
          </div>
        ))
      }
    </div>

    {
      sources.length > 0 && (
        <p class="reveal mt-10 border-t border-ink/10 pt-5 text-[0.8125rem] leading-relaxed text-slate">
          <span class="font-mono text-[0.6875rem] uppercase tracking-[0.14em] text-slate">
            Sources
          </span>
          <span class="mt-1 block">{sources.join(' · ')}</span>
        </p>
      )
    }
  </div>
</section>
)}

<script>
  /**
   * Scroll reveal — the only motion on the site, and only here.
   *
   * `prefers-reduced-motion` is honoured in CSS, which neutralises the
   * transition entirely, so this script's class toggle becomes a no-op for
   * anyone who has asked for less movement. If the script never runs, the
   * `.no-js` rule in global.css leaves everything visible.
   */
  const targets = document.querySelectorAll<HTMLElement>('.reveal');

  const reveal = (el: Element) => el.classList.add('is-visible');

  if (!('IntersectionObserver' in window)) {
    targets.forEach(reveal);
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          reveal(entry.target);
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
    );

    targets.forEach((el) => observer.observe(el));
  }
</script>
