---
/**
 * A photograph with an optional caption.
 *
 * Photography does the emotional work on this site, which is exactly why the
 * layout around it stays restrained.
 *
 * Usage: drop the file into src/assets/photos/ and pass its filename. No
 * import statement, no path. Alt text is required by the type signature
 * because an image without it is unusable to a screen reader.
 *
 * Before committing any photo, see the photo rules in EDITING.md:
 * max 2000px wide, under 400KB, no alcohol visible, consent for anyone
 * identifiable.
 */
import { Image } from 'astro:assets';
import { getPhoto } from '../lib/images';

interface Props {
  /** Filename only, e.g. "house-front.jpg". */
  src: string;
  /** Describe what is happening, not "photo of". Required. */
  alt: string;
  /** Optional visible caption, set in mono beneath the image. */
  caption?: string;
  /** Set true only for an above-the-fold image, to skip lazy loading. */
  priority?: boolean;
  class?: string;
}

const { src, alt, caption, priority = false, class: className = '' } = Astro.props;

// Throws a build error naming the available files if the filename is wrong.
const image = getPhoto(src);
---

<figure class:list={['w-full', className]}>
  <Image
    src={image}
    alt={alt}
    widths={[640, 960, 1280, 1920]}
    sizes="(min-width: 1152px) 1152px, 100vw"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
    class="w-full rounded-xs object-cover"
  />

  {
    caption && (
      <figcaption class="mt-3 font-mono text-[0.6875rem] uppercase leading-relaxed tracking-[0.1em] text-slate">
        {caption}
      </figcaption>
    )
  }
</figure>
